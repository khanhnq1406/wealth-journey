# Server Configuration
GRPC_SERVER_PORT=50051
GRPC_SERVER_HOST=localhost

# Database Configuration
# For Supabase: DB_HOST=[your-project].supabase.co, DB_PORT=5432
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-password
DB_NAME=postgres

# Database Connection Pool Settings
#
# Railway Free Tier PostgreSQL has a hard limit of 100 connections.
# These settings are optimized to prevent connection exhaustion.
#
# Platform-specific recommendations:
# - Railway Free Tier: Use defaults below (10 max open connections)
# - Railway Pro Tier: Can increase up to 25-30
# - Supabase Pro: 15 connections (max)
# - Supabase Enterprise: 60 connections (max)
#
# For multi-service deployments, calculate: (MaxOpenConns × Services) + Buffer < 100
# Example: (10 × 3 services) + 10 buffer = 40 connections (safe margin)
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=3
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# Redis Configuration
REDIS_URL=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=168h

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id

# Storage Configuration
STORAGE_PROVIDER=supabase  # Options: 'supabase' or 'local'
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_API_KEY=your-service-role-key-keep-secret
SUPABASE_BUCKET=wealthjourney-uploads
SUPABASE_COMMUNITY_BUCKET=community
UPLOAD_DIR=/tmp/wealthjourney-uploads  # Fallback for local storage

# Import Configuration
MAX_CSV_SIZE=10485760    # 10MB in bytes
MAX_EXCEL_SIZE=10485760  # 10MB
MAX_PDF_SIZE=20971520    # 20MB

# Web Push Notifications (VAPID)
#
# Required for push notifications to work. Without these, push is silently
# disabled (the API returns an empty publicKey and the noop service is used).
#
# Generate keys:  npx web-push generate-vapid-keys
#
# IMPORTANT: The private key is a secret — never commit it or expose it
# in frontend code. Only the public key is sent to clients.
#
# VAPID_CONTACT: Use a plain email address (no mailto: prefix).
# The webpush-go library adds "mailto:" automatically. If you include it
# here, the VAPID JWT will contain "mailto:mailto:..." which Apple rejects
# with BadJwtToken.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=admin@example.com

# Price Alert Configuration
#
# Thresholds are percentage changes that trigger alerts.
# The scheduler checks every 15 minutes. First run sets baselines only.
# Cooldown prevents duplicate alerts for the same category within the window.
PRICE_ALERT_GOLD_VND_PCT=2.0      # Gold VND % threshold (default: 2.0)
PRICE_ALERT_GOLD_USD_PCT=1.5      # Gold USD % threshold (default: 1.5)
PRICE_ALERT_SILVER_VND_PCT=3.0    # Silver VND % threshold (default: 3.0)
PRICE_ALERT_SILVER_USD_PCT=2.0    # Silver USD % threshold (default: 2.0)
PRICE_ALERT_COOLDOWN_MINUTES=120  # Minutes between alerts per category (default: 120)